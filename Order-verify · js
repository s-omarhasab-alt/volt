/* ==========================================================================
   ⚠️ ORDER PRICE VERIFICATION — كشف التلاعب في السعر (Admin-side)
   ==========================================================================
   الفكرة: مفيش منع قبل الحفظ (ده محتاج Cloud Function + Blaze plan). بدل
   كده، الملف ده بيراجع كل أوردر بعد ما اتحفظ فعلاً، ويقارن كل سطر فيه
   (item.price) بالسعر الحقيقي المخزّن دلوقتي في مستند المنتج نفسه في
   Firestore. لو فيه أي فرق، الأوردر ده بيتعتبر "مشتبه فيه" ويظهر
   بعلامة حمراء واضحة في لوحة التحكم.

   ⚠️ حدود مهمة لازم الأدمن يفهمها:
   1. ده كشف بعد الحفظ، مش منع. الأوردر المضروب اتحفظ فعلاً في orders،
      والمخزون (stock) اتخصم فعلاً وقت الإضافة للسلة — مش وقت الدفع.
      لو الأوردر مرفوض، لازم ترجع الكمية للمخزون يدوياً (زي أي رفض
      طلب عادي في الكود الحالي).
   2. المقارنة بتحصل مقابل *السعر الحالي* للمنتج في Firestore دلوقتي،
      مش السعر وقت ما العميل عمل الأوردر. لو انت غيّرت سعر المنتج
      بعد ما العميل اشترى (زيادة أو تخفيض شرعي)، الأوردر القديم ده
      هيظهر "مختلف" برضه — مش لازم يبقى تلاعب. راجع دايماً بعينك
      قبل ما تاخد قرار نهائي، العلامة الحمرا تنبيه مش حكم قاطع.
   3. لو المنتج اتحذف من المتجر خلاص بعد ما العميل اشتراه، مش هينفع
      نتأكد من سعره التاريخي — الأوردر ده هيتعلّم "تعذر التحقق" بدل
      "تلاعب"، عشان منفترضش حاجة مش أكيدة.
   ========================================================================== */

(function () {
    "use strict";

    /**
     * verifyOrderPricing(order)
     * --------------------------
     * ياخد أوردر واحد (نفس الشكل المخزّن في orders collection)، ويرجع
     * تقرير مفصّل عن كل سطر فيه: هل السعر مطابق للسعر الحقيقي دلوقتي
     * في products، وإيه الفرق لو موجود.
     *
     * Returns:
     *   {
     *     hasTampering: boolean,        // true لو فيه أي سطر سعره مختلف فعلياً
     *     hasUnverifiable: boolean,     // true لو فيه منتج اتحذف، مقدرناش نتأكد منه
     *     lineResults: [
     *       {
     *         name, storedPrice, realPrice, quantity,
     *         status: "match" | "mismatch" | "unverifiable",
     *         difference: number  // realPrice - storedPrice (موجب = العميل دفع أقل)
     *       }, ...
     *     ]
     *   }
     */
    async function verifyOrderPricing(order) {
        const lineResults = [];
        let hasTampering = false;
        let hasUnverifiable = false;

        const items = Array.isArray(order.items) ? order.items : [];

        for (const item of items) {
            // FIX: أوردرات قديمة اتحفظت قبل أي تعديل مستقبلي على شكل
            // items ممكن متكونش فيها productId (الشكل الحالي في script.js
            // بيخزن name/price/emoji بس، من غير id مرجعي واضح). في الحالة
            // دي مينفعش نتحقق خالص — نسجلها unverifiable صراحة بدل ما
            // نتجاهلها بصمت أو نفترض إنها سليمة.
            const productId = item.productId || item.id || null;
            const storedPrice = Number(item.price) || 0;
            const quantity = Number(item.quantity) || 1;

            if (!productId) {
                lineResults.push({
                    name: item.name || "منتج غير معروف",
                    storedPrice,
                    realPrice: null,
                    quantity,
                    status: "unverifiable",
                    difference: null
                });
                hasUnverifiable = true;
                continue;
            }

            try {
                let productData = null;
                if (window.voltFirebase && typeof window.voltFirebase.getProducts === "function") {
                    // إعادة استخدام قائمة المنتجات المحمّلة بدل استعلام فردي
                    // لكل سطر — أوفر لو الأوردر فيه عشرات الأصناف.
                    const allProducts = await window.voltFirebase.getProducts();
                    productData = (allProducts || []).find(p => String(p.id) === String(productId));
                }

                if (!productData) {
                    // المنتج مش موجود دلوقتي — اتحذف، أو productId مش
                    // مطابق لأي مستند حالي. تعذر التحقق، مش تلاعب مؤكد.
                    lineResults.push({
                        name: item.name || "منتج محذوف",
                        storedPrice,
                        realPrice: null,
                        quantity,
                        status: "unverifiable",
                        difference: null
                    });
                    hasUnverifiable = true;
                    continue;
                }

                const realPrice = Number(productData.price) || 0;
                const difference = realPrice - storedPrice;

                // FIX: تفاوت أقل من قرش (floating point rounding) ميتحسبش
                // تلاعب — نفس منطق التقريب المستخدم فعلاً في
                // validatePromoCodeInFirestore (Math.round(x * 100) / 100).
                const isMismatch = Math.abs(difference) >= 0.01;

                lineResults.push({
                    name: item.name || productData.name || "منتج",
                    storedPrice,
                    realPrice,
                    quantity,
                    status: isMismatch ? "mismatch" : "match",
                    difference: Math.round(difference * 100) / 100
                });

                if (isMismatch) hasTampering = true;

            } catch (err) {
                console.warn("verifyOrderPricing: فشل التحقق من منتج", productId, err);
                lineResults.push({
                    name: item.name || "منتج",
                    storedPrice,
                    realPrice: null,
                    quantity,
                    status: "unverifiable",
                    difference: null
                });
                hasUnverifiable = true;
            }
        }

        return { hasTampering, hasUnverifiable, lineResults };
    }

    // ── واجهة عامة يستخدمها index.html / script.js ─────────────────────────
    window.__voltVerifyOrderPricing = verifyOrderPricing;
})();