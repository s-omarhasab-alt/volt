/* ==========================================================================
   api-response.js — uniform HTTP-style response envelope for Firestore /
   Callable results. Purely additive: nothing existing imports or requires
   this today, so introducing it breaks nothing by itself. config.js and
   order-verify.js are updated separately to add *Envelope siblings that
   use it, alongside their original, untouched functions.

   Contract:
     ok(data, status?)        -> { ok: true,  status, data, error: null }
     fail(status, message, code?) -> { ok: false, status, data: null, error: { message, code } }
     mapFirebaseError(err)    -> fail(...) with a SAFE, fixed message —
                                 never forwards err.message or err.stack.
   ========================================================================== */

export const HTTP_STATUS = Object.freeze({
    OK: 200,
    CREATED: 201,
    BAD_REQUEST: 400,
    UNAUTHORIZED: 401,
    FORBIDDEN: 403,
    NOT_FOUND: 404,
    UNPROCESSABLE: 422,
    INTERNAL: 500
});

export function ok(data, status = HTTP_STATUS.OK) {
    return { ok: true, status, data, error: null };
}

export function fail(status, message, code = null) {
    return { ok: false, status, data: null, error: { message, code } };
}

// Firebase/Firestore/Auth/Callable error code -> [HTTP status, safe Arabic
