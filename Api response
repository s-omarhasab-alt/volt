/**
 * Maps ANY thrown Firebase/Firestore/Auth/Callable error to a safe,
 * standardized fail() envelope. This is the single required chokepoint:
 * every catch block in this codebase that wraps a Firebase call should
 * route the caught error through this function instead of reading
 * err.message directly.
 *
 * Full error detail (code, message, stack) is logged to console for
 * developer/ops visibility — it is NEVER included in the returned
 * envelope, so it can never reach a toast, alert, or rendered DOM node.
 */
export function mapFirebaseError(err, context) {
    const code = err && (err.code || err.name);
    const mapped = code ? FIREBASE_ERROR_MAP[code] : null;

    if (mapped) {
        // eslint-disable-next-line no-console
        console.error(`[${context || "mapFirebaseError"}]`, code, err);
        return fail(mapped[0], mapped[1], code);
    }

    // Unknown/unmapped error code — log full detail server/console-side
    // only. Client-facing message stays generic; code field carries
    // whatever code we did get (may be null) purely for log correlation,
    // never rendered to the user by any call site in this codebase.
    // eslint-disable-next-line no-console
    console.error(`[${context || "mapFirebaseError"}] unmapped error`, code, err);
    return fail(HTTP_STATUS.INTERNAL, "حدث خطأ غير متوقع، حاول مرة أخرى", code || "unknown");
}

/**
 * Generates a client-side idempotency key: timestamp + random suffix.
 * NOTE: this key only prevents duplicate submission if the SERVER-SIDE
 * Cloud Function (createSecureOrder, not in this file's scope) checks it
 * against a store of already-processed keys before writing an order.
 * Sending this key alone, with no server-side dedup check behind it, does
 * NOT by itself prevent duplicate orders — it is the client half of a
 * two-sided contract. See createSecureOrderEnvelope in config.js.
 */
export function generateIdempotencyKey() {
    const rand = (typeof crypto !== "undefined" && crypto.getRandomValues)
        ? Array.from(crypto.getRandomValues(new Uint8Array(8))).map(b => b.toString(16).padStart(2, "0")).join("")
        : Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);
    return `idem_${Date.now()}_${rand}`;
}